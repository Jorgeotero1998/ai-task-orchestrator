# ======================
# Backend (FastAPI)
# ======================
# Local dev (docker-compose): use the internal hostname `db`
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ai_task_orchestrator
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_task_orchestrator

JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.3-70b-versatile

# ======================
# Frontend (Next.js)
# ======================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
