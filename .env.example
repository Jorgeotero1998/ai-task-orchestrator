# ======================
# Backend (FastAPI) — required on Vercel
# ======================
DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DB

JWT_SECRET=generate-a-strong-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin1234!

# Seeded login accounts (also created in DB on startup):
#   admin@example.com / Admin1234!
#   demo@orchestrator.dev / Demo1234!

# Groq LLM (free tier at https://console.groq.com/keys)
# Without this key the app uses a built-in demo orchestrator (always works).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CORS_ORIGINS_CSV=https://ai-task-orchestrator-inky.vercel.app

# ======================
# Frontend (Next.js)
# ======================
NEXT_PUBLIC_API_BASE_URL=/api
API_BASE_URL_INTERNAL=/api
